[Unit]
Description=OpenDash API
After=network.target

[Service]
Type=simple
User=opendash
Group=opendash
WorkingDirectory=/var/lib/opendash
ExecStart=/usr/local/bin/opendash
Restart=on-failure
RestartSec=5

Environment=OPENDASH_HTTP_HOST=127.0.0.1
Environment=OPENDASH_HTTP_PORT=8080
Environment=OPENDASH_LOG_LEVEL=info
Environment=OPENDASH_USE_DOCKER_RUNTIME=false
Environment=OPENDASH_DB_PATH=/var/lib/opendash/opendash.db
Environment=OPENDASH_DEMO_MODE=false
Environment=OPENDASH_AUTH_ENABLED=true
Environment=OPENDASH_SECURE_COOKIES=true
Environment=OPENDASH_SESSION_LIFETIME=24h

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/var/lib/opendash
AmbientCapabilities=
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
